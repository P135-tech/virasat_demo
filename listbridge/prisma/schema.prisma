generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Its own free Neon database: paste the connection string into DATABASE_URL on Render.
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// One connected Etsy shop per Shopify store.
model EtsyConnection {
  shop           String   @id
  installId      String? // Shopify app installation this connection belongs to (a reinstall gets a new id)
  etsyUserId     String
  etsyShopId     String
  etsyShopName   String
  currency       String // the Etsy shop's currency (listing prices are in this currency)
  accessToken    String // encrypted (AES-256-GCM); valid 1 hour, refreshed automatically
  refreshToken   String // encrypted; valid 90 days
  expiresAt      DateTime
  connectedAt    DateTime @default(now())
}

// Short-lived PKCE login attempts (Etsy requires PKCE on every login).
model EtsyAuthState {
  state     String   @id
  shop      String
  verifier  String
  createdAt DateTime @default(now())
}

// What every new Etsy listing gets, chosen once by the merchant.
model ListingDefaults {
  shop              String  @id
  taxonomyId        Int?
  taxonomyPath      String?
  whoMade           String  @default("someone_else") // i_did | someone_else | collective
  whenMade          String  @default("made_to_order") // Etsy's when_made value
  shippingProfileId String?
  readinessStateId  String? // Etsy processing profile
  returnPolicyId    String?
  exchangeRate      Float   @default(1) // 1 unit of the Shopify currency = this many units of the Etsy currency
  markupPercent     Float   @default(0) // added on top of the converted price
}

// A Shopify product and its Etsy listing.
model ListingLink {
  id               String   @id @default(cuid())
  shop             String
  shopifyProductId String // gid://shopify/Product/...
  title            String
  etsyListingId    String?
  status           String   @default("queued") // queued | sending | draft | failed
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([shop, shopifyProductId])
  @@index([shop, status])
}
