# Set these in Render → Environment (never commit real values).
SHOPIFY_API_KEY=            # ListBridge Client ID (Dev Dashboard)
SHOPIFY_API_SECRET=         # ListBridge Client secret
SHOPIFY_APP_URL=https://listbridge.onrender.com
SCOPES=read_products,read_inventory
DATABASE_URL=               # Neon connection string (its own database, not ReelStage's)
TOKEN_ENCRYPTION_KEY=       # long random text, 40+ characters; never change it later
ETSY_API_KEY=               # Etsy app "keystring"
ETSY_SHARED_SECRET=         # Etsy app "shared secret"
PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1
SUPPORT_EMAIL=
COMPANY_NAME=
