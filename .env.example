# Copy to .env for local development. On Render, add these under Environment (never commit real values).
SHOPIFY_API_KEY=            # Client ID of the "ReelStage" app (Partner dashboard)
SHOPIFY_API_SECRET=         # Client secret of that app
SHOPIFY_APP_URL=https://reelstage.onrender.com
SCOPES=read_files,write_files,read_themes
DATABASE_URL=               # Neon connection string (postgresql://...)
META_APP_ID=                # Meta app → App settings → Basic → App ID
META_APP_SECRET=            # Meta app → App settings → Basic → App secret
META_LOGIN_CONFIG_ID=       # Meta app → Facebook Login for Business → Configurations → Configuration ID
TOKEN_ENCRYPTION_KEY=       # any long random text (40+ characters); keep it the same forever
META_GRAPH_VERSION=v25.0    # optional
SUPPORT_EMAIL=              # shown on the privacy page and App Store listing
COMPANY_NAME=               # legal name of the business that publishes the app
